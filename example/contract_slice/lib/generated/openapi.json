{
  "openapi": "3.1.0",
  "info": {
    "title": "Laska API",
    "version": "0.1.0"
  },
  "paths": {
    "/v1/users/{id}": {
      "get": {
        "operationId": "UsersService.GetUser",
        "tags": [
          "UsersService"
        ],
        "summary": "GetUser returns a single user by its identifier.",
        "description": "GetUser returns a single user by its identifier.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/v1/users": {
      "get": {
        "operationId": "UsersService.ListUsers",
        "tags": [
          "UsersService"
        ],
        "summary": "ListUsers returns a page of users.",
        "description": "ListUsers returns a page of users.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ListUsersResponse"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      },
      "post": {
        "operationId": "UsersService.CreateUser",
        "tags": [
          "UsersService"
        ],
        "summary": "CreateUser creates a new user.",
        "description": "CreateUser creates a new user.\nThe call changes something, so it is never retried.",
        "responses": {
          "200": {
            "description": "Successful response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "default": {
            "description": "Error response",
            "content": {
              "application/problem+json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "type": "string"
                    },
                    "title": {
                      "type": "string"
                    },
                    "status": {
                      "type": "integer"
                    },
                    "detail": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "type",
                    "title",
                    "status",
                    "detail"
                  ]
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "$ref": "#/components/schemas/UserRole"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "email",
          "displayName",
          "role"
        ],
        "additionalProperties": false
      },
      "GetUserRequest": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      },
      "ListUsersRequest": {
        "type": "object",
        "properties": {
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "cursor": {
            "type": "string"
          }
        },
        "required": [
          "limit",
          "cursor"
        ],
        "additionalProperties": false
      },
      "ListUsersResponse": {
        "type": "object",
        "properties": {
          "users": {
            "$ref": "#/components/schemas/User"
          },
          "nextCursor": {
            "type": "string"
          }
        },
        "required": [
          "nextCursor"
        ],
        "additionalProperties": false
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "$ref": "#/components/schemas/UserRole"
          }
        },
        "required": [
          "email",
          "displayName",
          "role"
        ],
        "additionalProperties": false
      },
      "Subscription": {
        "type": "object",
        "properties": {
          "plan": {
            "$ref": "#/components/schemas/SubscriptionPlan"
          },
          "state": {
            "type": "string",
            "$ref": "#/components/schemas/SubscriptionState"
          },
          "features": {
            "type": "object",
            "additionalProperties": {
              "type": "boolean"
            }
          },
          "cardToken": {
            "type": "string"
          },
          "iban": {
            "type": "string"
          }
        },
        "required": [
          "plan",
          "state"
        ],
        "oneOf": [
          {
            "required": [
              "cardToken",
              "iban"
            ]
          }
        ],
        "additionalProperties": false
      },
      "SubscriptionPlan": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "seats": {
            "type": "integer",
            "format": "int64"
          }
        },
        "required": [
          "name",
          "seats"
        ],
        "additionalProperties": false
      },
      "UserRole": {
        "type": "string",
        "enum": [
          "USER_ROLE_UNSPECIFIED",
          "USER_ROLE_ADMIN",
          "USER_ROLE_MEMBER"
        ]
      },
      "SubscriptionState": {
        "type": "string",
        "enum": [
          "SUBSCRIPTION_STATE_ACTIVE",
          "SUBSCRIPTION_STATE_PAUSED"
        ]
      }
    }
  }
}